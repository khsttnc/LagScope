{
  "_help": "LagScope settings. Most switches can also be toggled from the tray menu. Process names are without .exe; wildcards (*) allowed.",

  "overlay": "auto",
  "gameMode": true,
  "autoRamCleaner": true,
  "stopDevTools": true,

  "sampleIntervalMs": 2000,

  "ramCleanerMinFreeMB": 2048,
  "ramCleanerMinStandbyMB": 1024,
  "ramCleanerCooldownSeconds": 60,

  "games": [
    "TslGame",
    "dota2",
    "bf1",
    "cs2",
    "VALORANT-Win64-Shipping",
    "FortniteClient-Win64-Shipping",
    "r5apex",
    "GTA5",
    "RobloxPlayerBeta",
    "fm",
    "ManorLords-Win64-Shipping"
  ],
  "autoDetectGameFolders": [
    "\\steamapps\\common\\",
    "\\Epic Games\\",
    "\\Riot Games\\",
    "\\EA Games\\",
    "\\Electronic Arts\\",
    "\\Ubisoft Game Launcher\\games\\",
    "\\XboxGames\\",
    "\\GOG Galaxy\\Games\\"
  ],
  "notGames": [
    "*Launcher*",
    "*CrashHandler*",
    "*CrashReport*",
    "EasyAntiCheat*",
    "BEService*",
    "*Setup*",
    "*Updater*",
    "*Helper*",
    "ExecPubg"
  ],

  "closeApps": [
    "Spotify",
    "HD-Player",
    "BlueStacks*",
    "OneDrive",
    "Teams",
    "ms-teams",
    "PhoneExperienceHost",
    "YourPhone",
    "Widgets"
  ],
  "neverTouch": [
    "Discord",
    "steam",
    "steamwebhelper",
    "EpicGamesLauncher",
    "Battle.net",
    "RiotClientServices",
    "NVIDIA*",
    "nvcontainer",
    "Razer*",
    "lghub*",
    "audiodg",
    "obs64",
    "explorer",
    "powershell",
    "pwsh",
    "Claude",
    "BEService*",
    "EasyAntiCheat*",
    "vgc"
  ],
  "forceCloseAfterSeconds": 5,
  "reopenAppsAfterGame": true,

  "trimBackgroundRam": true,
  "trimMinProcessMB": 150,
  "purgeStandbyOnGameStart": true,
  "setGameHighPriority": false,
  "highPerformancePowerPlan": true,
  "stopServices": [],

  "devProcesses": [
    "llama-server*",
    "ollama*",
    "Docker Desktop",
    "com.docker.*",
    "vpnkit*"
  ],
  "devServerPatterns": [
    "expo[\\\\/]bin[\\\\/]cli",
    "next[\\\\/]dist[\\\\/]bin[\\\\/]next",
    "next[\\\\/]dist[\\\\/]server",
    "vite[\\\\/]bin",
    "webpack-dev-server",
    "nodemon",
    "react-scripts[\\\\/]scripts[\\\\/]start"
  ],
  "shutdownWsl": true
}
